# Public Vite configuration
VITE_NEON_AUTH_URL=https://your-endpoint.neonauth.c-2.sa-east-1.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://your-endpoint.apirest.c-2.sa-east-1.aws.neon.tech/neondb/rest/v1
VITE_ANALYZE_DECK_URL=https://diegodev-api.vercel.app/api/analyze-deck

# Server/CI only. Never prefix these values with VITE_.
# Fetch actual values with: neon env pull --service postgres --file .env.neon.local
DATABASE_URL=postgresql://user:password@your-endpoint-pooler.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:password@your-endpoint.neon.tech/neondb?sslmode=verify-full

# analyze-deck function secrets
NEON_DATA_API_URL=https://your-endpoint.apirest.c-2.sa-east-1.aws.neon.tech/neondb/rest/v1
NEON_AUTH_BASE_URL=https://your-endpoint.neonauth.c-2.sa-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://your-endpoint.neonauth.c-2.sa-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
# Optional override; InsForge's reserved API_KEY is used when omitted.
INSFORGE_URL=https://your-app.region.insforge.app
INSFORGE_AI_KEY=your-server-only-ai-key
ALLOWED_ORIGINS=https://diegui.dev,https://www.diegui.dev,http://localhost:5173
